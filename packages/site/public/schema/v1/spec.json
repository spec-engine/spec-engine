{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.spec-engine.dev/schema/v1/spec.json",
  "title": "Spec Engine domain file (SPEC.json)",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "key": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*$"
    },
    "owner": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "specVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "updated": {
      "type": "string"
    },
    "scope": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "grammar": {
      "type": "string",
      "enum": [
        "ears",
        "freeform"
      ]
    },
    "grammarSeverity": {
      "type": "string",
      "enum": [
        "warning",
        "error"
      ]
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*-\\d+$"
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "supersedes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "supersededBy": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "relates": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "livesIn": {
            "deprecated": true
          },
          "verifiedIn": {
            "deprecated": true
          },
          "issues": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "minLength": 1
                },
                "id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "role",
                "id"
              ],
              "additionalProperties": false
            }
          },
          "changedAtVersion": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "supersededAtVersion": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "deprecatedReason": {
            "type": "string"
          },
          "term": {
            "type": "string"
          },
          "aliases": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cites": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "term": {
                  "type": "string"
                },
                "pinned": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "term",
                "pinned"
              ],
              "additionalProperties": false
            }
          },
          "section": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "status",
          "statement"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "key",
    "updated",
    "requirements"
  ],
  "additionalProperties": false
}
